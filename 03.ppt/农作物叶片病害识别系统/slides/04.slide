<Slide style={{ padding: 0, position: 'relative', overflow: 'hidden', background: '#FFFFFF' }}>

    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='leaf' style={{ fill: '#8FB6E8', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#FFFFFF' }}>农作物叶片病害识别系统</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#8FB6E8' }}>01 项目背景与目标</Text>
    </Box>

    <Box style={{ position: 'absolute', top: 76, left: 40 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E3F8C' }}>为什么做：基层植保的识别缺口</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 132, left: 40, width: 1200, height: 2, background: '#D6DCE5' }} />

    {/* 左栏卡 */}
    <Box style={{ position: 'absolute', top: 152, left: 40, width: 760, height: 440, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: '26px 28px', flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 6, height: 26, background: '#1E4FA8' }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>现实困境</Text>
        </Box>
        <Box style={{ height: 18 }} />
        <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.7 }}>
            农技人员主要依靠肉眼与经验判断病害，主观性强、效率低；基层农技站人手有限，一名技术员往往要覆盖上千亩地，农户发现问题时常常已错过最佳防治窗口。
        </Text>
        <Box style={{ height: 16 }} />
        <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.7 }}>
            更棘手的是，<span style={{ fontWeight: 'bold', color: '#D9534F' }}>同作物的近缘病害病斑形态高度相似</span>——番茄细菌性斑点病与黄化曲叶病毒病、玉米灰斑病与北方叶枯病，肉眼很难稳定分辨。
        </Text>
        <Box style={{ height: 20 }} />
        <Box style={{ background: '#E8EFF8', borderRadius: 6, padding: '14px 18px' }}>
            <Text style={{ fontSize: 22, color: '#0E3F8C', lineHeight: 1.5 }}>
                把"专家经验"沉淀成可复用、可规模化分发的模型，是本项目的起点。
            </Text>
        </Box>
    </Box>

    {/* 右栏卡 */}
    <Box style={{ position: 'absolute', top: 152, left: 820, width: 420, height: 440, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '24px', flexDirection: 'column' }}>
        <Image src="assets/sample_apple_scab.jpg" style={{ width: 372, height: 210, objectFit: 'cover', borderRadius: 6 }} />
        <Box style={{ height: 12 }} />
        <Text style={{ fontSize: 16, color: '#8B97A8' }}>苹果黑星病叶片（PlantVillage 实拍）</Text>
        <Box style={{ height: 16 }} />
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0E3F8C' }}>肉眼难分</Text>
        <Box style={{ height: 8 }} />
        <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.6 }}>
            橄榄色绒状病斑与早期锈病极易混淆，经验不足者误判率高。
        </Text>
    </Box>

    {/* 底部强调条 */}
    <Box style={{ position: 'absolute', top: 600, left: 40, width: 1200, height: 40, background: '#0E3F8C', borderRadius: 6, flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 12 }}>
        <FAIcon name='info-circle' style={{ fill: '#FFC107', width: 20, height: 20 }} />
        <Text style={{ fontSize: 22, color: '#FFFFFF' }}>
            项目定位：辅助识别与科普工具，结果仅供参考，不能替代现场专业农技诊断。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>前沿技术实训 · 2026</Text>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>04 / 15</Text>
    </Box>

</Slide>
