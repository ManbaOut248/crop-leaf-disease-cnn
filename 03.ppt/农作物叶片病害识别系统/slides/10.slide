        <Box style={{ height: 12 }} />

        <Box style={{ height: 76, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, flexDirection: 'row', alignItems: 'center', padding: '0 18px', gap: 14 }}>
            <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 17, justifyContent: 'center', alignItems: 'center' }}>
