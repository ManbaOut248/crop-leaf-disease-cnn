            <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 17, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>推理</Text>
