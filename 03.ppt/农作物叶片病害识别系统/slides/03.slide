<Slide style={{ padding: 0, position: 'relative', overflow: 'hidden', background: '#FFFFFF' }}>

    {/* 顶条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 56, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <FAIcon name='leaf' style={{ fill: '#8FB6E8', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#FFFFFF' }}>农作物叶片病害识别系统</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#8FB6E8' }}>01 项目背景与目标</Text>
    </Box>

    {/* 巨型数字背景 */}
    <Box style={{ position: 'absolute', top: 120, left: 60, width: 520, height: 500, justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 300, fontWeight: 'bold', color: '#E8EFF8', lineHeight: 1 }}>01</Text>
    </Box>

    {/* 巨型数字前景（描边效果用深蓝实字叠在浅蓝底字上偏左） */}
    <Box style={{ position: 'absolute', top: 120, left: 40, width: 520, height: 500, justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 240, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>01</Text>
    </Box>

    {/* 右侧标题与要点 */}
    <Box style={{ position: 'absolute', top: 168, left: 620, width: 620, flexDirection: 'column' }}>

        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#0E3F8C' }}>项目背景与目标</Text>

        <Box style={{ height: 18 }} />

        <Box style={{ width: 80, height: 4, background: '#FFC107' }} />

        <Box style={{ height: 36 }} />

        <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 4, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6, width: 566 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>行业痛点</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.5 }}>诊断依赖人工经验，基层农技力量不足，常错过最佳防治窗口。</Text>
            </Box>
        </Box>

        <Box style={{ height: 26 }} />

        <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 4, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6, width: 566 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>任务书指标</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.5 }}>整体准确率 ≥ 85%，各类别 F1 ≥ 0.80，并交付可运行系统。</Text>
            </Box>
        </Box>

        <Box style={{ height: 26 }} />

        <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 4, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6, width: 566 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>范围收敛</Text>
                <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.5 }}>口径由 26 类扩展到 PlantVillage 真实覆盖的 38 类，属正向超额交付。</Text>
            </Box>
        </Box>

    </Box>

    {/* 页脚 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>前沿技术实训 · 2026</Text>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>03 / 15</Text>
    </Box>

</Slide>
