# =============================================================================
# Nginx 反向代理样例（任务书 6.2：HTTPS 加密传输）
#
# 拓扑：浏览器 --HTTPS--> Nginx --HTTP(127.0.0.1)--> uvicorn:8000
#       Nginx 同时托管前端静态资源（dist/），/api 反代到后端。
#
# 使用前替换：
#   server_name      你的域名（无域名用 IP 或 localhost）
#   ssl_certificate  证书路径（正式环境用 Let's Encrypt，本地可用
#                    scripts/gen_selfsigned_cert.py 生成的自签名证书）
#   root             前端构建产物目录（cd src/web && npm run build → dist）
#
# 后端启动方式（务必带 --no-proxy-headers，并设置 TRUST_PROXY=1）：
#   set TRUST_PROXY=1
#   py -3.12 -m uvicorn src.api.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
# 原因：TRUST_PROXY=1 才让限流按 X-Forwarded-For 取真实来源；
#       --no-proxy-headers 关闭 uvicorn 自己的代理头改写，避免两层同时改写导致口径混乱。
# =============================================================================

# ---------- 80：全部跳转到 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Let's Encrypt HTTP-01 校验需保留该路径（用 certbot 时）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- 443：TLS 终止 + 反代 ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 只启用 TLS 1.2/1.3；关闭老协议与弱套件
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS：首次访问后强制浏览器走 HTTPS（先用短 max-age 试运行，确认无误再调大）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # 上传限制需 ≥ 后端 MAX_UPLOAD_MB(10MB) + multipart 开销
    client_max_body_size 12m;

    # ---------- 前端静态资源 ----------
    root /opt/leafdisease/web;
    index index.html;

    location / {
        # SPA 路由：找不到文件时回落到 index.html，避免刷新 404
        try_files $uri $uri/ /index.html;
    }

    # 带 hash 的构建产物可长期缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ---------- 后端 API ----------
    location /api/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # 这两个头是后端取真实客户端 IP 与协议的依据（需 TRUST_PROXY=1 才受信任）
        proxy_set_header   X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;

        proxy_set_header   Host             $host;
        proxy_set_header   Connection       "";

        # 推理接口首帧较慢（模型加载），超时放宽
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
