# ============ 模型权重（大文件，训练产物，不入库） ============
models/*.pth
models/*.pt
# OOD 检测头（由 scripts/train_ood_head.py 生成，可一键重建）
models/*.pkl
models/*.npz
models/backup_preC/

# ============ 数据集原始数据 + 切分副本（PlantVillage 等，共约 4.5 GB，绝不入库） ============
# 整目录忽略：防止 `git add .` 误把 6.3 万张图片带进仓库
data/
data/split/

# ============ OOD 拒识测试集 / 公开数据集下载缓存（大文件，不入库） ============
data/ood_set/
data/_downloads/
# 归因实验的对照组数据（仅原始 363 张，可用 expand_ood_set.py 前状态重建，19MB）
data/_ood_baseline/
# 验证脚本运行时生成的灰阶临时图
outputs/_tmp_verify_gray/

# PlantDoc test 划分（外部验证用，120 张约 35MB；由 scripts/fetch_plantdoc_test.py 重建）
outputs/realtest_test/*/

# 真实场景测试图（PlantDoc 下载，100+ 张约 56MB；可由 scripts/fetch_plantdoc.py 一键重建）
# 注意只忽略子目录，outputs/realtest/README.md 仍入库（记录来源与 CC BY 4.0 署名要求）
outputs/realtest/*/

# ============ 运行时产物 ============
data/uploads/
data/app.db
# SQLite WAL 模式运行时文件（#D 启用后产生）
data/app.db-wal
data/app.db-shm

# ============ 训练/评估中间索引 ============
outputs/index/

# ============ 日志 ============
*.log

# ============ 备份目录（历史版本，便于回滚，不入库） ============
backups/

# ============ 前端依赖 / 构建产物（Node） ============
node_modules/
**/node_modules/
# dist/ 及构建校验用的 dist-verify/ 等临时产物
src/web/dist*/
src/web/build/
# vite 构建校验临时目录（.check-build* / .vite-check*）
src/web/.check-build*/
src/web/.vite-check*/
.vite/

# ============ Python 缓存 ============
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# ============ PPT 生成中间缓存（.pptx 与 slides/ 入库，缓存不入库） ============
**/.slidep/
**/.cache/
# PPT 生成用的图片素材（.pptx 成品入库，素材可重新生成）
**/assets_v*/

# ============ 实验过程截图与临时调试图（精选展示图已入库，过程产物不入库） ============
outputs/shot_*/
outputs/chart_shots/
outputs/crop_diag/
outputs/_*.png
outputs/dbg_*.png

# ============ 工作区元数据 ============
.workbuddy/

# ============ 编辑器 / IDE ============
.vscode/
.idea/
*.swp

# ============ 环境变量 / 密钥（绝不入库） ============
.env

# ============ TLS 证书与私钥（含私钥，绝不入库） ============
certs/
data/plantdoc_raw/
data/real_mix/
data/real_mix_test/
_pred.json
test_images/
