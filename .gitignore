# ============ 模型权重（大文件，训练产物，不入库） ============
models/*.pth
models/*.pt
models/backup_preC/

# ============ 数据集切分副本（约 5.4 万张图，超大，不入库） ============
data/split/

# ============ 运行时产物 ============
data/uploads/
data/app.db
# SQLite WAL 模式运行时文件（#D 启用后产生）
data/app.db-wal
data/app.db-shm

# ============ 训练/评估中间索引 ============
outputs/index/

# ============ 日志 ============
*.log

# ============ 备份目录（历史版本，便于回滚，不入库） ============
backups/

# ============ 前端依赖 / 构建产物（Node） ============
node_modules/
**/node_modules/
# dist/ 及构建校验用的 dist-verify/ 等临时产物
src/web/dist*/
src/web/build/
.vite/

# ============ Python 缓存 ============
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# ============ PPT 生成中间缓存（.pptx 与 slides/ 入库，缓存不入库） ============
**/.slidep/
**/.cache/

# ============ 工作区元数据 ============
.workbuddy/

# ============ 编辑器 / IDE ============
.vscode/
.idea/
*.swp

# ============ 环境变量 / 密钥（绝不入库） ============
.env
